# The database: its own, on the shared Postgres
DATABASE_URL=postgresql://stream:password@vps.niso.moe:5432/stream?sslmode=verify-full

# Signs sessions and encrypts the platforms' tokens: `openssl rand -base64 32`.
# Changing it signs you out and disconnects every platform.
BETTER_AUTH_SECRET=

# Where stream runs. Set in docker-compose.yml on the server; for local
# development, http://localhost:3000
BETTER_AUTH_URL=http://localhost:3000

# The mail server, for verifying your email, sign-in codes and password
# resets, e.g. smtps://no-reply%40niso.moe:password@mail.niso.moe
SMTP_URL=
EMAIL_FROM=stream <no-reply@niso.moe>

# The platforms, each turned on by its client id and secret. Their redirect
# URL is <BETTER_AUTH_URL>/api/auth/callback/<id>: see the README.
# Twitch: https://dev.twitch.tv/console/apps
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
# YouTube, by a Google Cloud OAuth client: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
